          <level>0</level><default>192.168.4.103</default><control type="edit" format="string"/>
        </setting>
        <setting id="device_id" type="string" label="Room ID (bedroom, lounge, dining)">
          <level>0</level><default>bedroom</default><control type="edit" format="string"/>
        </setting>
        <setting id="history_key" type="string" label="Dedicated BS5c YouTube key">
          <level>0</level><default></default><control type="edit" format="string" hidden="true"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
